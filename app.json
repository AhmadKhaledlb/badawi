{
  "expo": {
    "name": "BADAWI",
    "slug": "badawi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/v2/badawi-icon.png",
    "scheme": "badawi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/v2/badawi-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#353C56",
        "foregroundImage": "./assets/brand/v2/badawi-adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/v2/badawi-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F2EB",
          "image": "./assets/brand/v2/badawi-mark-dark.png",
          "imageWidth": 132,
          "dark": {
            "backgroundColor": "#071829",
            "image": "./assets/brand/v2/badawi-mark-light.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
